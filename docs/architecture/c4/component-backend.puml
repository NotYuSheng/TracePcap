@startuml component-backend
' TracePcap: C4 level 3, the backend's components grouped by pipeline stage.
' The stages and their contracts: docs/architecture/layers.rst. Render: scripts/render-diagrams.sh
' D = deterministic, L = LLM-driven, H = human-annotated.
!include <C4/C4_Component>

LAYOUT_TOP_DOWN()
title TracePcap backend: components by pipeline stage\npackets → facts → insights → conclusions → narrative

Container(spa, "Web app", "React", "Reads through the Present stage")
ContainerDb(postgres, "Database", "PostgreSQL")
ContainerDb(minio, "Object storage", "MinIO")
Container(tools, "Packet tools", "tshark, ndpiReader, Suricata, mergecap")
System_Ext(llm, "LLM server", "local, OpenAI-compatible")

Container_Boundary(backend, "Backend (Spring Boot)") {
  Component(ingest, "Ingest", "file, cleanup [D]", "Upload, MinIO, mergecap, retention")
  Component(extract, "Extract", "analysis, hostlog, extraction [D]", "Observations with witnesses: MEASURED / REPORTED / INFERRED, append-only, with a run manifest")
  Component(scan, "Scan", "hostclassification, story detectors, monitor, subnets, signatures, reconciliation, cluster [D+L+H]", "Additive: derives insights from facts, never reads the capture")
  Component(adjudicate, "Adjudicate", "insights, adjudication [D+L+H]", "Exclusive: one voice per question; human answers rank first; 'contested' is a legal outcome")
  Component(knowledge, "Knowledge layer", "knowledge [D]", "The blackboard: entities, relationships and findings every surface reads")
  Component(narrate, "Narrate", "story, tracer, filter, capture chat [L]", "Cites evidence; offline LLM only, queued as background AI jobs")
  Component(present, "Present", "conversation, timeline, intelligence, networkmap, report [D]", "The read surface and its views; no judgment")
  Component(governance, "Governance", "governance, policy, preferences [H]", "Roles and permissions, the audit log, settings, who has signed in")
}

Rel(spa, present, "Reads", "REST /api/v1")
Rel(spa, governance, "Settings, roles", "REST /api/v1")
Rel(ingest, extract, "capture")
Rel(extract, scan, "facts")
Rel(scan, adjudicate, "insights")
Rel(adjudicate, knowledge, "conclusions")
Rel(knowledge, narrate, "evidence")
Rel(narrate, present, "narrative")
Rel_Back(scan, adjudicate, "adjudications re-enter as INFERRED unless a human confirmed them")

Rel(ingest, minio, "Stores the capture", "S3")
Rel(extract, tools, "Runs", "subprocess")
Rel(narrate, llm, "Findings, not packets", "HTTP")
Rel(present, postgres, "Reads", "JPA")
Rel(governance, postgres, "Roles, audit log", "JPA")

SHOW_LEGEND()
@enduml
