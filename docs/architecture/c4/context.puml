@startuml context
' TracePcap: C4 level 1, system context. Render: scripts/render-diagrams.sh
' The C4 library ships inside PlantUML, so this renders offline (no !includeurl).
!include <C4/C4_Context>

LAYOUT_WITH_LEGEND()
title TracePcap: system context

Person(analyst, "Analyst", "Uploads packet captures and investigates them: devices, conversations, findings, the story. Monitors networks over time.")
Person(admin, "Admin", "Runs the install: retention, analysis policy, the LLM connection, and what each role may do.")

System(tracepcap, "TracePcap", "Turns packet captures into a picture of the network: which devices are there, what each one is, who talked to whom, and what looks wrong. Runs fully offline.")

System_Ext(idp, "Identity provider", "Keycloak: bundled with the login-on deployment, or your organisation's own realm. Decides who may sign in and which TracePcap roles they have. Optional: login can be off.")
System_Ext(llm, "LLM server", "A local OpenAI-compatible inference server (LM Studio, Ollama, vLLM) at LLM_BASE_URL. Writes stories and insights, answers questions. Optional.")
System_Ext(ipinfo, "ipinfo.io", "Online IP geolocation. Optional: used only when reachable; a bundled DB-IP database answers otherwise.")

Rel(analyst, tracepcap, "Uploads captures, investigates, monitors networks", "HTTPS, browser")
Rel(admin, tracepcap, "Configures the install and the roles", "HTTPS, browser")
Rel(admin, idp, "Assigns roles to groups and people", "Keycloak admin console")
Rel(tracepcap, idp, "Signs people in; checks their tokens", "OpenID Connect")
Rel(tracepcap, llm, "Sends findings, not raw packets", "HTTP, OpenAI API")
Rel(tracepcap, ipinfo, "Looks up public addresses", "HTTPS")
@enduml
