# Stop at this directory when resolving config (this is the Maven module root).
config.stopBubbling = true

# Mark Lombok-generated members with @lombok.Generated so JaCoCo excludes them from
# coverage. Without this, hundreds of generated getters/setters/builders/equals count as
# covered or uncovered code and the coverage figure measures Lombok, not our logic.
lombok.addLombokGeneratedAnnotation = true
